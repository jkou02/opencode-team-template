{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "opencode-go/glm-5.3",
  "update": "notify",
  "share": "manual",
  "shell": "/bin/bash",
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "plugins": [
    "./vendor/i-have-adhd/.opencode/plugins/i-have-adhd.mjs"
  ],
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" }
  ],
  "agents": {
    "title": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "permissions": [
        { "action": "skill", "resource": "graphify", "effect": "allow" },
        { "action": "shell", "resource": "graphify *", "effect": "allow" },
        { "action": "shell", "resource": "*graphify_python*", "effect": "allow" },
        { "action": "shell", "resource": "mkdir -p graphify-out*", "effect": "allow" }
      ]
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 16000
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/.mypy_cache/**",
      "**/.pytest_cache/**",
      "**/.ruff_cache/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/.turbo/**",
      "**/coverage/**",
      "**/graphify-out/**"
    ]
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "GITHUB_PERSONAL_ACCESS_TOKEN"
        }
      }
    }
  }
}
